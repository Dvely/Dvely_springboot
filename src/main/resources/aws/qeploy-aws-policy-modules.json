{
  "modules": [
    {
      "key": "core",
      "label": "연결 확인",
      "description": "키가 어느 계정의 것인지 확인합니다. 모든 연결에 필요합니다.",
      "required": true,
      "defaultSelected": true,
      "sids": ["VerifyCallerIdentity"]
    },
    {
      "key": "backendServer",
      "label": "백엔드 서버 (EC2)",
      "description": "EC2 에 백엔드·Docker 앱을 띄우고 고정 IP·보안 그룹·인스턴스 역할·환경변수 비밀(SSM)·로그 조회를 다룹니다. 빌드 결과물은 qeploy-* S3 버킷으로 전달합니다. Docker DB 와 EC2 프론트 호스팅도 이 묶음을 씁니다.",
      "required": false,
      "defaultSelected": true,
      "sids": [
        "Ec2Provisioning",
        "S3SiteAndArtifacts",
        "SsmQeployParameters",
        "SsmReadPublicAmiParameter",
        "SsmRunCommandOnInstances",
        "ManageInstanceRoles",
        "PassInstanceRoleToEc2"
      ]
    },
    {
      "key": "managedDatabase",
      "label": "관리형 DB (RDS)",
      "description": "RDS 인스턴스를 만들고 지웁니다. DB 전용 보안 그룹을 만들기 위해 EC2 권한을 함께 씁니다. RDS 를 처음 쓰는 계정은 서비스 연결 역할을 한 번 만들어야 해서 그 권한도 들어 있습니다.",
      "required": false,
      "defaultSelected": true,
      "sids": ["RdsProvisioning", "RdsServiceLinkedRole", "Ec2Provisioning"]
    },
    {
      "key": "staticFrontend",
      "label": "프론트 정적 호스팅 (S3 + CloudFront + HTTPS)",
      "description": "프론트 빌드를 qeploy-* S3 버킷에 올리고 CloudFront 와 ACM 인증서로 HTTPS 도메인을 붙입니다.",
      "required": false,
      "defaultSelected": true,
      "sids": ["S3SiteAndArtifacts", "CloudFrontDistributions", "AcmForCloudFront"]
    },
    {
      "key": "ecrImages",
      "label": "Docker 이미지 ECR 전송",
      "description": "서버의 이미지 전송 방식을 ECR 로 켠 경우에만 필요합니다. 기본 S3 전송이면 고르지 않습니다. 이미지 만료 정책(PutLifecyclePolicy)이 없으면 이미지가 계속 쌓여 ECR 비용이 늘어납니다.",
      "required": false,
      "defaultSelected": false,
      "statements": [
        {
          "Sid": "EcrAuthToken",
          "Effect": "Allow",
          "Action": "ecr:GetAuthorizationToken",
          "Resource": "*"
        },
        {
          "Sid": "EcrPushManageQeployScoped",
          "Effect": "Allow",
          "Action": [
            "ecr:CreateRepository",
            "ecr:DescribeRepositories",
            "ecr:DeleteRepository",
            "ecr:BatchCheckLayerAvailability",
            "ecr:InitiateLayerUpload",
            "ecr:UploadLayerPart",
            "ecr:CompleteLayerUpload",
            "ecr:PutImage",
            "ecr:BatchGetImage",
            "ecr:GetDownloadUrlForLayer",
            "ecr:PutLifecyclePolicy"
          ],
          "Resource": "arn:aws:ecr:*:*:repository/qeploy-app-*"
        }
      ]
    }
  ]
}
